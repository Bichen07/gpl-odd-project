(cl:defmethod roslisp-msg-protocol:ros-message-to-list ((msg <AndroidBuildInfo>))
  "Converts a ROS message object to a list"
  (cl:list 'AndroidBuildInfo
    (cl:cons ':header (header msg))
    (cl:cons ':radioVersion (radioVersion msg))
    (cl:cons ':versionCodename (versionCodename msg))
    (cl:cons ':hardware (hardware msg))
    (cl:cons ':versionSecurityPatch (versionSecurityPatch msg))
    (cl:cons ':supportedAbis (supportedAbis msg))
    (cl:cons ':id (id msg))
    (cl:cons ':board (board msg))
