    (cl:cons ':host (host msg))
    (cl:cons ':user (user msg))
    (cl:cons ':fingerprint (fingerprint msg))
    (cl:cons ':device (device msg))
    (cl:cons ':bootloader (bootloader msg))
    (cl:cons ':model (model msg))
