Panels:
  - Class: rviz/Displays
    Help Height: 138
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Status1
        - /TF1/Frames1
        - /Semantic Map1/Namespaces1
        - /trackers1/Namespaces1
        - /Simulation Scenario1/Namespaces1
      Splitter Ratio: 0.6277777552604675
    Tree Height: 946
  - Class: rviz/Selection
    Name: Selection
  - Class: rviz/Tool Properties
    Expanded:
      - /2D Pose Estimate1
      - /2D Nav Goal1
      - /Publish Point1
    Name: Tool Properties
    Splitter Ratio: 0.5886790156364441
  - Class: rviz/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz/Time
    Experimental: false
    Name: Time
    SyncMode: 0
    SyncSource: ""
  - Class: jsk_rviz_plugin/SelectPointCloudPublishAction
    Name: SelectPointCloudPublishAction
Preferences:
  PromptSaveOnExit: true
Toolbars:
  toolButtonStyle: 2
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 10
      Class: rviz/Grid
      Color: 160; 160; 164
      Enabled: false
      Line Style:
        Line Width: 0.029999999329447746
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: map
      Value: false
    - Class: rviz/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: false
        base_link:
          Value: true
        base_linkSD:
          Value: true
        frenet:
          Value: true
        gps:
          Value: true
        lidar:
          Value: true
        map:
          Value: true
        odom:
          Value: true
      Marker Scale: 1
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Tree:
        map:
          base_link:
            {}
          gps:
            {}
      Update Interval: 0
      Value: true
    - Class: rviz/Marker
      Enabled: true
      Marker Topic: /rviz_waypoints
      Name: Waypoints
      Namespaces:
        {}
      Queue Size: 100
      Value: true
    - Class: rviz/Marker
      Enabled: true
      Marker Topic: /global_path/marker
      Name: Global Path
      Namespaces:
        {}
      Queue Size: 99
      Value: true
    - Class: rviz/Marker
      Enabled: true
      Marker Topic: /vis_local_paths
      Name: Local Path
      Namespaces:
        {}
      Queue Size: 100
      Value: true
    - Alpha: 1
      Class: rviz/RobotModel
      Collision Enabled: false
      Enabled: true
      Links:
        All Links Enabled: true
        Expand Joint Details: false
        Expand Link Details: false
        Expand Tree: false
        Link Tree Style: Links in Alphabetic Order
        base_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
      Name: Vehicle Model
      Robot Description: robot_description
      TF Prefix: ""
      Update Interval: 0
      Value: true
      Visual Enabled: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /viz_IA_ROI
      Name: IA ROI
      Namespaces:
        {}
      Queue Size: 100
      Value: true
    - Class: rviz/Marker
      Enabled: true
      Marker Topic: /viz_AEB_obj
      Name: AEB Objects
      Namespaces:
        {}
      Queue Size: 100
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /viz_Action_Markers
      Name: Action Markers
      Namespaces:
        IAObj: true
        blocker: true
        collisionPoint: true
        collisionROI: true
        points_and_lines: true
        predictedPath: true
        revelationLine: true
        weightedBlocker: true
        weightedCollisionPoint: true
      Queue Size: 100
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /semantic_waypoint_array
      Name: Semantic Map
      Namespaces:
        line_list: true
        line_strip: true
        navg_road_color_line: true
        opposite_lane_color_line: true
        parking_space_color_line: true
        route_croad_color_line: true
        waypoint_color_line: true
      Queue Size: 100
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /trackers
      Name: trackers
      Namespaces:
        hull: true
        speed: true
        speed_variance: false
      Queue Size: 100
      Value: true
    - Alpha: 1
      Class: jsk_rviz_plugin/PolygonArray
      Color: 25; 255; 0
      Enabled: true
      Name: Cluster Hulls
      Topic: /front_cluster_hulls
      Unreliable: false
      Value: true
      coloring: Auto
      enable lighting: true
      normal length: 0.10000000149011612
      only border: true
      show normal: true
    - Class: rviz/Marker
      Enabled: true
      Marker Topic: /aeb_roi_rviz
      Name: aeb roi
      Namespaces:
        {}
      Queue Size: 100
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /crop_roi_rviz
      Name: non accessible
      Namespaces:
        {}
      Queue Size: 100
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /simulation/scenario_visualization
      Name: Simulation Scenario
      Namespaces:
        {}
      Queue Size: 100
      Value: true
    - Class: rviz/Marker
      Enabled: true
      Marker Topic: /rviz_waypoints
      Name: waypoints
      Namespaces:
        {}
      Queue Size: 100
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /semantic_roadmarker_array
      Name: Semantic Road Marker Array
      Namespaces:
        boundaries_line_strip: true
        road_marker_color_line: true
      Queue Size: 100
      Value: true
    - Class: rviz/Marker
      Enabled: true
      Marker Topic: /behavior/aeb_roi
      Name: AEB ROI
      Namespaces:
        {}
      Queue Size: 100
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /scenario_visualization
      Name: Scenario
      Namespaces:
        {}
      Queue Size: 100
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /tag_trees
      Name: Tag Trees
      Namespaces:
        {}
      Queue Size: 100
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /tag_trees_matches
      Name: Tag Trees Matches
      Namespaces:
        {}
      Queue Size: 100
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /features_matches
      Name: Feature Matches
      Namespaces:
        {}
      Queue Size: 100
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Default Light: true
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
    - Class: rviz/SetInitialPose
      Theta std deviation: 0.2617993950843811
      Topic: /initialpose
      X std deviation: 0.5
      Y std deviation: 0.5
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
    - Class: rviz/PublishPoint
      Single click: true
      Topic: /clicked_point
  Value: true
  Views:
    Current:
      Angle: 0.8449994921684265
      Class: rviz/TopDownOrtho
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.05999999865889549
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.009999999776482582
      Scale: 7.038209438323975
      Target Frame: base_link
      Value: TopDownOrtho (rviz)
      X: 9.371647834777832
      Y: 12.84001350402832
    Saved: ~
Window Geometry:
  Displays:
    collapsed: true
  Height: 1037
  Hide Left Dock: true
  Hide Right Dock: true
  QMainWindow State: 
  SelectPointCloudPublishAction:
    collapsed: true
  Selection:
    collapsed: false
  Time:
    collapsed: false
  Tool Properties:
    collapsed: false
  Views:
    collapsed: true
  Width: 1793
  X: 2201
  Y: 326
