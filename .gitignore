.temp

# Large local datasets — do not push to GitHub (files exceed 100MB limit)
alldatasets/

# Python cache
__pycache__/
*.pyc
*.pyo

# BEV output images — generated locally, not committed
bev_output/**/*.jpg
bev_output/**/*.png

# results/ — generated outputs (local only)
results/
!results/README.md

# Paper casestudy media mirror (large zips; scripts stay tracked)
data/paper_casestudies/**
!data/paper_casestudies/README.md
!data/paper_casestudies/manifest.json

# LLM pipeline run captures — auto-generated at runtime (capture.py), not committed
app/llm_pipeline/artifacts/

# Mission Control per-run logs and generated launch scripts
simulation/ros/.cache/mission_control/runs/

# start_dev_stack.sh / stop_dev_stack.sh logs and pid files
logs/dev_stack/

# PDF files
*.pdf
