<?xml version="1.0" encoding="UTF-8"?>
<OpenSCENARIO>
  <FileHeader revMajor="1"
    revMinor="0"
    date="2024-01-04T11:33:00"
    description="Agent opposite turn right to mall parking gateway"
    author="chiu41" />
  <ParameterDeclarations>

    <ParameterDeclaration name="Road270Length" parameterType="double" value="86.724" />
    <ParameterDeclaration name="EgoStuckDuration" parameterType="double" value="10" />

    <ParameterDeclaration name="ego_carriagewayUser" parameterType="string" value="car_white" />
    <ParameterDeclaration name="carriagewayUser" parameterType="string" value="car_red" />

    <!-- <ParameterDeclaration name="roadId0" parameterType="int" value="270" /> -->
    <!-- <ParameterDeclaration name="laneId0" parameterType="double" value="-1" /> -->
    <!-- <ParameterDeclaration name="s0" parameterType="double" value="10" /> -->
    <!-- <ParameterDeclaration name="offset0" parameterType="double" value="0" /> -->
    <!---->
    <!-- <ParameterDeclaration name="roadIdf" parameterType="int" value="108" /> -->
    <!-- <ParameterDeclaration name="laneIdf" parameterType="double" value="-1" /> -->
    <!-- <ParameterDeclaration name="sf" parameterType="double" value="100" /> -->
    <!-- <ParameterDeclaration name="offsetf" parameterType="double" value="0" /> -->

    <ParameterDeclaration name="roadId0" parameterType="int" value="108" />
    <ParameterDeclaration name="laneId0" parameterType="double" value="1" />
    <ParameterDeclaration name="s0" parameterType="double" value="0.1" />
    <ParameterDeclaration name="offset0" parameterType="double" value="0" />

    <ParameterDeclaration name="roadIdf" parameterType="int" value="270" />
    <ParameterDeclaration name="laneIdf" parameterType="double" value="2" />
    <ParameterDeclaration name="sf" parameterType="double" value="0" />
    <ParameterDeclaration name="offsetf" parameterType="double" value="0" />

    <ParameterDeclaration name="rho" parameterType="double" value="1000.0" />
    <ParameterDeclaration name="b" parameterType="double" value="0" />

    <ParameterDeclaration name="v0" unit="kph" parameterType="double" value="0" />
    <ParameterDeclaration name="lambda" parameterType="double" value="0.0" />

    <ParameterDeclaration name="x0" parameterType="double" value="20" />
    <ParameterDeclaration name="a0" parameterType="double" value="9.8" />
    <ParameterDeclaration name="vf" parameterType="double" value="80" />

  </ParameterDeclarations>
  <CatalogLocations>
    <VehicleCatalog>
      <Directory path="/project/mmsl_simulation/src/scenario/data/resources/xosc/Catalogs/Vehicles" />
    </VehicleCatalog>
    <ControllerCatalog>
      <Directory
        path="/project/mmsl_simulation/src/scenario/data/resources/xosc/Catalogs/Controllers" />
    </ControllerCatalog>
  </CatalogLocations>
  <RoadNetwork>
    <LogicFile
      filepath="/project/mmsl_simulation/src/scenario/data/resources/xodr/ego_no_turn.xodr" />
    <!-- <LogicFile
    filepath="/project/mmsl_simulation/src/scenario/data/resources/xodr/bdsc_export.xodr" /> -->
  </RoadNetwork>
  <Entities>
    <ScenarioObject name="Ego">
      <CatalogReference catalogName="VehicleCatalog" entryName="$ego_carriagewayUser" />

      <!-- <ObjectController> -->
      <!--   <Controller name="ALKS_R157SM_Controller"> -->
      <!--     <Properties> -->
      <!--       <Property name="mode" value="override" /> -->
      <!--       <Property name="model" value="Regulation" /> -->
      <!--       <Property name="logLevel" value="2" /> -->
      <!--       <Property name="cruise" value="false" /> -->
      <!--       <Property name="cutInPerceptionDelayMode" value="Time" /> -->
      <!--       <Property name="fullStop" value="true" /> -->
      <!--       <Property name="lateralTrigDistance" value="0.5" /> -->
      <!--       <Property name="aebTTC" value="1.2" /> -->
      <!--     </Properties> -->
      <!--   </Controller> -->
      <!-- </ObjectController> -->

      <ObjectController>
        <CatalogReference catalogName="ControllerCatalog" entryName="externalController" />
      </ObjectController>

    </ScenarioObject>
    <ScenarioObject name="Agent">
      <CatalogReference catalogName="VehicleCatalog" entryName="$carriagewayUser" />
      <ObjectController>
        <CatalogReference catalogName="ControllerCatalog" entryName="followRoute">
          <ParameterAssignments>
            <ParameterAssignment parameterRef="TestMode" value="true" />
          </ParameterAssignments>
        </CatalogReference>
      </ObjectController>
    </ScenarioObject>
  </Entities>
  <Storyboard>

    <Init>
      <Actions>
        <Private entityRef="Ego">
          <PrivateAction>
            <TeleportAction>
              <Position>
                <!-- <WorldPosition x="532" y="-3.4" h="-2.532" /> -->
                <WorldPosition x="0" y="0" h="0" />
              </Position>
            </TeleportAction>
          </PrivateAction>

          <!-- <PrivateAction> -->
          <!--   <LongitudinalAction> -->
          <!--     <SpeedAction> -->
          <!--       <SpeedActionDynamics dynamicsShape="step" value="0.0" -->
          <!--         dynamicsDimension="time" /> -->
          <!--       <SpeedActionTarget> -->
          <!--         <AbsoluteTargetSpeed value="${10 / 3.6}" /> -->
          <!--       </SpeedActionTarget> -->
          <!--     </SpeedAction> -->
          <!--   </LongitudinalAction> -->
          <!-- </PrivateAction> -->

          <PrivateAction>
            <ControllerAction>
              <ActivateControllerAction longitudinal="true" lateral="true" />
            </ControllerAction>
          </PrivateAction>
        </Private>
        <Private entityRef="Agent">
          <PrivateAction>
            <TeleportAction>
              <Position>
                <!-- <LanePosition roadId="$roadId0" laneId="$laneId0" offset="$offset0" s="$s0" /> -->
                <LanePosition roadId="$roadId0" laneId="$laneId0" offset="${$offset0 + $lambda}"
                  s="$s0">
                </LanePosition>
              </Position>
            </TeleportAction>
          </PrivateAction>
          <PrivateAction>
            <ControllerAction>
              <ActivateControllerAction lateral="true" longitudinal="true" />
            </ControllerAction>
          </PrivateAction>
        </Private>
      </Actions>
    </Init>

    <Story name="MainStory">

      <Act name="StartValidAct">
        <StartTrigger>
          <ConditionGroup>
            <Condition name="StartValidCondition" delay="0" conditionEdge="none">
              <ByEntityCondition>
                <TriggeringEntities triggeringEntitiesRule="any">
                  <EntityRef entityRef="Ego" />
                </TriggeringEntities>
                <EntityCondition>
                  <ReachPositionCondition tolerance="3.0">
                    <Position>
                      <WorldPosition x="532.25" y="-3.48" z="0.0" />
                    </Position>
                  </ReachPositionCondition>
                </EntityCondition>
              </ByEntityCondition>
            </Condition>
          </ConditionGroup>
        </StartTrigger>
      </Act>

      <Act name="RouteAct">
        <ManeuverGroup maximumExecutionCount="1" name="RouteManeuverGroup">
          <Actors selectTriggeringEntities="false">
            <EntityRef entityRef="Agent" />
          </Actors>
          <Maneuver name="RouteManeuver">
            <Event name="RouteEvent" maximumExecutionCount="1" priority="overwrite">
              <Action name="RouteAction">
                <PrivateAction>
                  <RoutingAction>
                    <AssignRouteAction>
                      <Route name="AgentRoute" closed="false">
                        <ParameterDeclarations />
                        <Waypoint routeStrategy="fastest">
                          <Position>
                            <LanePosition roadId="$roadId0" laneId="$laneId0"
                              offset="${$offset0 + $lambda}" s="$s0" />
                          </Position>
                        </Waypoint>
                        <Waypoint routeStrategy="fastest">
                          <Position>
                            <LanePosition roadId="$roadIdf" laneId="$laneIdf" offset="$offsetf"
                              s="$sf" />
                          </Position>
                        </Waypoint>
                      </Route>
                    </AssignRouteAction>
                  </RoutingAction>
                </PrivateAction>
              </Action>
              <Action name="RouteSpeedAction">
                <PrivateAction>
                  <LongitudinalAction>
                    <SpeedAction>
                      <SpeedActionDynamics dynamicsShape="step" value="0.0"
                        dynamicsDimension="time" />
                      <SpeedActionTarget>
                        <AbsoluteTargetSpeed value="${$v0 / 3.6}" />
                      </SpeedActionTarget>
                    </SpeedAction>
                  </LongitudinalAction>
                </PrivateAction>
              </Action>
              <Action name="RouteAccAction">
                <PrivateAction>
                  <LongitudinalAction>
                    <SpeedAction>
                      <!-- <SpeedActionDynamics dynamicsShape="linear" value="$rho"
                      dynamicsDimension="time" /> -->
                      <!-- <SpeedActionTarget> -->
                      <!--   <AbsoluteTargetSpeed value="${$v0 / 3.6 + $rho * $a0}" /> -->
                      <!-- </SpeedActionTarget> -->
                      <SpeedActionDynamics dynamicsShape="linear" value="$a0"
                        dynamicsDimension="rate" />
                      <SpeedActionTarget>
                        <AbsoluteTargetSpeed value="${$vf / 3.6}" />
                      </SpeedActionTarget>
                    </SpeedAction>
                  </LongitudinalAction>
                </PrivateAction>
              </Action>
              <StartTrigger>
                <ConditionGroup>
                  <Condition name="StartCondition" delay="0" conditionEdge="rising">
                    <ByEntityCondition>
                      <TriggeringEntities triggeringEntitiesRule="any">
                        <EntityRef entityRef="Ego" />
                      </TriggeringEntities>
                      <EntityCondition>
                        <DistanceCondition value="$x0" freespace="true" rule="lessThan"
                          alongRoute="true">
                          <Position>
                            <WorldPosition x="452.98" y="-57.77" z="0.0" />
                          </Position>
                        </DistanceCondition>
                        <!-- <RelativeDistanceCondition relativeDistanceType="longitudinal" -->
                        <!--   entityRef="Agent" value="$x0" freespace="true" -->
                        <!--   rule="lessThan" alongRoute="true" /> -->
                      </EntityCondition>
                    </ByEntityCondition>
                  </Condition>
                </ConditionGroup>
              </StartTrigger>
            </Event>
          </Maneuver>
        </ManeuverGroup>
      </Act>
      <Act name="ReactionTimeAct">
        <StartTrigger>
          <ConditionGroup>
            <Condition name="ReactionTimeFinishedCondition" delay="$rho" conditionEdge="none">
              <ByValueCondition>
                <StoryboardElementStateCondition storyboardElementType="action"
                  storyboardElementRef="RouteAccAction" state="runningState" />
              </ByValueCondition>
            </Condition>
          </ConditionGroup>
        </StartTrigger>
      </Act>
      <Act name="ReachingEgoRouteAct">
        <StopTrigger>
          <ConditionGroup>
            <Condition name="ReachingEgoRouteCondition" delay="0" conditionEdge="rising">
              <ByEntityCondition>
                <TriggeringEntities triggeringEntitiesRule="any">
                  <EntityRef entityRef="Agent" />
                </TriggeringEntities>
                <EntityCondition>
                  <ReachPositionCondition tolerance="2">
                    <Position>
                      <WorldPosition x="461.82" y="-54.16" />
                    </Position>
                  </ReachPositionCondition>
                </EntityCondition>
              </ByEntityCondition>
            </Condition>
          </ConditionGroup>
        </StopTrigger>
      </Act>
      <Act name="BrakeAct">
        <ManeuverGroup maximumExecutionCount="1" name="BrakeManeuverGroup">
          <Actors selectTriggeringEntities="false">
            <EntityRef entityRef="Agent" />
          </Actors>
          <Maneuver name="BrakeManeuver">
            <Event name="BrakeEvent" maximumExecutionCount="1" priority="overwrite">
              <Action name="RouteSpeedAction">
                <PrivateAction>
                  <LongitudinalAction>
                    <SpeedAction>
                      <SpeedActionDynamics dynamicsShape="linear" value="${-$b}"
                        dynamicsDimension="rate" />
                      <SpeedActionTarget>
                        <AbsoluteTargetSpeed value="0" />
                      </SpeedActionTarget>
                    </SpeedAction>
                  </LongitudinalAction>
                </PrivateAction>
              </Action>
              <StartTrigger>
                <ConditionGroup>
                  <Condition name="ReactTimeActFinishedCondition" delay="0" conditionEdge="rising">
                    <ByValueCondition>
                      <StoryboardElementStateCondition storyboardElementType="act"
                        storyboardElementRef="ReactionTimeAct" state="runningState" />
                    </ByValueCondition>
                  </Condition>
                </ConditionGroup>
              </StartTrigger>
            </Event>
          </Maneuver>
        </ManeuverGroup>
      </Act>
      <Act name="SpeedRecoverAct">
        <ManeuverGroup maximumExecutionCount="1" name="SpeedRecoverManeuverGroup">
          <Actors selectTriggeringEntities="false">
            <EntityRef entityRef="Agent" />
          </Actors>
          <Maneuver name="SpeedRecoverManeuver">
            <Event name="SpeedRecoverEvent" maximumExecutionCount="1" priority="overwrite">
              <Action name="SpeedRecoverAction">
                <PrivateAction>
                  <LongitudinalAction>
                    <SpeedAction>
                      <SpeedActionDynamics dynamicsShape="linear" value="1" dynamicsDimension="rate" />
                      <SpeedActionTarget>
                        <AbsoluteTargetSpeed value="${30 / 3.6}" />
                      </SpeedActionTarget>
                    </SpeedAction>
                  </LongitudinalAction>
                </PrivateAction>
              </Action>
              <StartTrigger>
                <ConditionGroup>
                  <Condition name="BrakeEventRunnedCondition" delay="0" conditionEdge="none">
                    <ByValueCondition>
                      <StoryboardElementStateCondition storyboardElementType="event"
                        storyboardElementRef="BrakeEvent" state="completeState" />
                    </ByValueCondition>
                  </Condition>
                  <Condition name="SpeedZeroCondition" delay="0" conditionEdge="none">
                    <ByEntityCondition>
                      <TriggeringEntities triggeringEntitiesRule="any">
                        <EntityRef entityRef="Agent" />
                      </TriggeringEntities>
                      <EntityCondition>
                        <SpeedCondition value="0" rule="equalTo" />
                      </EntityCondition>
                    </ByEntityCondition>
                  </Condition>
                  <Condition name="IsEgoSafePositionReachCondition" delay="0" conditionEdge="none">
                    <ByEntityCondition>
                      <TriggeringEntities triggeringEntitiesRule="any">
                        <EntityRef entityRef="Ego" />
                      </TriggeringEntities>
                      <EntityCondition>
                        <ReachPositionCondition tolerance="25">
                          <Position>
                            <WorldPosition x="436.2" y="-69.2" />
                          </Position>
                        </ReachPositionCondition>
                      </EntityCondition>
                    </ByEntityCondition>
                  </Condition>
                </ConditionGroup>
                <ConditionGroup>
                  <Condition name="BrakeEventRunnedCondition" delay="0" conditionEdge="none">
                    <ByValueCondition>
                      <StoryboardElementStateCondition storyboardElementType="event"
                        storyboardElementRef="BrakeEvent" state="completeState" />
                    </ByValueCondition>
                  </Condition>
                  <Condition name="SpeedZeroCondition" delay="0" conditionEdge="none">
                    <ByEntityCondition>
                      <TriggeringEntities triggeringEntitiesRule="any">
                        <EntityRef entityRef="Agent" />
                      </TriggeringEntities>
                      <EntityCondition>
                        <SpeedCondition value="0" rule="equalTo" />
                      </EntityCondition>
                    </ByEntityCondition>
                  </Condition>
                </ConditionGroup>
              </StartTrigger>
            </Event>
          </Maneuver>
        </ManeuverGroup>
      </Act>
    </Story>
    <StopTrigger>
      <ConditionGroup>
        <Condition name="EgoReachWaitingToEndPositionCondition" delay="2" conditionEdge="rising">
          <ByEntityCondition>
            <TriggeringEntities triggeringEntitiesRule="any">
              <EntityRef entityRef="Ego" />
            </TriggeringEntities>
            <EntityCondition>
              <ReachPositionCondition tolerance="3">
                <Position>
                  <WorldPosition x="453.32" y="-57.78" z="0.0" />
                </Position>
              </ReachPositionCondition>
            </EntityCondition>
          </ByEntityCondition>
        </Condition>
      </ConditionGroup>
      <ConditionGroup>
        <Condition name="EgoReachDestinationCondition" delay="0" conditionEdge="rising">
          <ByEntityCondition>
            <TriggeringEntities triggeringEntitiesRule="any">
              <EntityRef entityRef="Ego" />
            </TriggeringEntities>
            <EntityCondition>
              <ReachPositionCondition tolerance="3">
                <Position>
                  <LanePosition roadId="270" laneId="2" s="20" offset="0" />
                </Position>
              </ReachPositionCondition>
            </EntityCondition>
          </ByEntityCondition>
        </Condition>
      </ConditionGroup>
      <ConditionGroup>
        <Condition name="EgoStuckCondition" delay="0" conditionEdge="rising">
          <ByEntityCondition>
            <TriggeringEntities triggeringEntitiesRule="any">
              <EntityRef entityRef="Ego" />
            </TriggeringEntities>
            <EntityCondition>
              <StandStillCondition duration="10" />
            </EntityCondition>
          </ByEntityCondition>
        </Condition>
      </ConditionGroup>
    </StopTrigger>
  </Storyboard>
</OpenSCENARIO>
