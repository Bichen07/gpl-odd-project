<OpenSCENARIO>

  <FileHeader revMajor="1" revMinor="1" date="2021-07-09T10:00:00" description="Two blocking cars"
    author="chiu41">
  </FileHeader>

  <ParameterDeclarations>
    <ParameterDeclaration name="Blocking1Width" unit="m" parameterType="double" value="2.2" />
    <ParameterDeclaration name="Blocking2Width" unit="m" parameterType="double" value="2.2" />
    <ParameterDeclaration name="Blocking1Length" unit="m" parameterType="double" value="5.04" />
    <ParameterDeclaration name="Blocking2Length" unit="m" parameterType="double" value="5.04" />

    <ParameterDeclaration name="egoRoadId" unit="m" parameterType="double" value="88" />
    <ParameterDeclaration name="egoS" unit="m" parameterType="double" value="0" />
    <ParameterDeclaration name="roadId" unit="m" parameterType="double" value="12" />
    <ParameterDeclaration name="initialS" unit="m" parameterType="double" value="30" />
    <ParameterDeclaration name="backgroundGap" unit="m" parameterType="double" value="7" />
    <ParameterDeclaration name="parkingOffset" unit="m" parameterType="double" value="-0.7" />
    <ParameterDeclaration name="backgroundOffset" unit="m" parameterType="double" value="-3.5" />
    <ParameterDeclaration name="backgroundLane" unit="m" parameterType="double" value="-1.0" />
    <ParameterDeclaration name="initialDelta" unit="m" parameterType="double" value="120" />

    <ParameterDeclaration name="x0" unit="m" parameterType="double" value="100" />
    <ParameterDeclaration name="v0" unit="m" parameterType="double" value="40" />
    <ParameterDeclaration name="y0" unit="m" parameterType="double" value="0.0" />
  </ParameterDeclarations>

  <CatalogLocations>
    <VehicleCatalog>
      <Directory path="/project/mmsl_simulation/src/scenario/data/resources/xosc/Catalogs/Vehicles" />
    </VehicleCatalog>
    <PedestrianCatalog>
      <Directory
        path="/project/mmsl_simulation/src/scenario/data/resources/xosc/Catalogs/Pedestrians" />
    </PedestrianCatalog>
    <ControllerCatalog>
      <Directory
        path="/project/mmsl_simulation/src/scenario/data/resources/xosc/Catalogs/Controllers" />
    </ControllerCatalog>
  </CatalogLocations>

  <RoadNetwork>
    <LogicFile
      filepath="/project/mmsl_simulation/src/scenario/data/resources/xodr/hct_4.xodr" />
  </RoadNetwork>

  <Entities>

    <ScenarioObject name="Ego">
      <CatalogReference catalogName="VehicleCatalog" entryName="car_white"></CatalogReference>

      <!-- <ObjectController> -->
      <!--   <CatalogReference catalogName="ControllerCatalog"
      entryName="ALKSController"></CatalogReference> -->
      <!-- </ObjectController> -->

      <ObjectController>
        <CatalogReference catalogName="ControllerCatalog" entryName="externalController" />
      </ObjectController>

    </ScenarioObject>

    <ScenarioObject name="Parking">
      <CatalogReference catalogName="VehicleCatalog" entryName="car_red">
        <ParameterAssignments>
          <ParameterAssignment parameterRef="width" value="$Blocking1Width" />
          <ParameterAssignment parameterRef="length" value="$Blocking1Length" />
        </ParameterAssignments>
      </CatalogReference>
    </ScenarioObject>

    <ScenarioObject name="Opposite">
      <CatalogReference catalogName="VehicleCatalog" entryName="car_red">
        <ParameterAssignments>
          <ParameterAssignment parameterRef="width" value="$Blocking2Width" />
          <ParameterAssignment parameterRef="length" value="$Blocking2Length" />
        </ParameterAssignments>
      </CatalogReference>
    </ScenarioObject>

    <ScenarioObject name="BackgroundParking1">
      <CatalogReference catalogName="VehicleCatalog" entryName="car_yellow"></CatalogReference>
    </ScenarioObject>

    <ScenarioObject name="BackgroundParking2">
      <CatalogReference catalogName="VehicleCatalog" entryName="car_yellow"></CatalogReference>
    </ScenarioObject>

    <ScenarioObject name="BackgroundParking3">
      <CatalogReference catalogName="VehicleCatalog" entryName="car_yellow"></CatalogReference>
    </ScenarioObject>

    <ScenarioObject name="BackgroundParking4">
      <CatalogReference catalogName="VehicleCatalog" entryName="car_yellow"></CatalogReference>
    </ScenarioObject>

    <ScenarioObject name="BackgroundParking5">
      <CatalogReference catalogName="VehicleCatalog" entryName="car_yellow"></CatalogReference>
    </ScenarioObject>

    <ScenarioObject name="BackgroundParking6">
      <CatalogReference catalogName="VehicleCatalog" entryName="car_yellow"></CatalogReference>
    </ScenarioObject>

    <ScenarioObject name="BackgroundParking7">
      <CatalogReference catalogName="VehicleCatalog" entryName="car_yellow"></CatalogReference>
    </ScenarioObject>

  </Entities>

  <Storyboard>

    <Init>
      <Actions>

        <Private entityRef="Ego">

          <PrivateAction>
            <TeleportAction>
              <Position>
                <!-- <LanePosition roadId="$egoRoadId" laneId="-1" offset="0.0"
                s="$egoS"></LanePosition> -->
                <WorldPosition x="0" y="0" z="0.0" />
              </Position>
            </TeleportAction>
          </PrivateAction>

          <!-- <PrivateAction> -->
          <!--   <LongitudinalAction> -->
          <!--     <SpeedAction> -->
          <!--       <SpeedActionDynamics dynamicsShape="step" dynamicsDimension="time" value="0" /> -->
          <!--       <SpeedActionTarget> -->
          <!--         <AbsoluteTargetSpeed value="${50 / 3.6}" /> -->
          <!--       </SpeedActionTarget> -->
          <!--     </SpeedAction> -->
          <!--   </LongitudinalAction> -->
          <!-- </PrivateAction> -->

          <PrivateAction>
            <ControllerAction>
              <ActivateControllerAction lateral="true" longitudinal="true" />
            </ControllerAction>
          </PrivateAction>

        </Private>

        <Private entityRef="Parking">
          <PrivateAction>
            <TeleportAction>
              <Position>
                <LanePosition roadId="$roadId" laneId="-1" offset="$parkingOffset" s="$initialS"></LanePosition>
              </Position>
            </TeleportAction>
          </PrivateAction>
        </Private>

        <Private entityRef="Opposite">

          <PrivateAction>
            <TeleportAction>
              <Position>
                <WorldPosition x="10000" y="10000" z="-10" />
              </Position>
            </TeleportAction>
          </PrivateAction>

        </Private>

        <Private entityRef="BackgroundParking1">
          <PrivateAction>
            <TeleportAction>
              <Position>
                <LanePosition roadId="$roadId" laneId="$backgroundLane" offset="$backgroundOffset"
                  s="$initialS"></LanePosition>
              </Position>
            </TeleportAction>
          </PrivateAction>
        </Private>

        <Private entityRef="BackgroundParking2">
          <PrivateAction>
            <TeleportAction>
              <Position>
                <LanePosition roadId="$roadId" laneId="$backgroundLane" offset="$backgroundOffset"
                  s="${$initialS + $backgroundGap}"></LanePosition>
              </Position>
            </TeleportAction>
          </PrivateAction>
        </Private>

        <Private entityRef="BackgroundParking3">
          <PrivateAction>
            <TeleportAction>
              <Position>
                <LanePosition roadId="$roadId" laneId="$backgroundLane" offset="$backgroundOffset"
                  s="${$initialS - $backgroundGap}"></LanePosition>
              </Position>
            </TeleportAction>
          </PrivateAction>
        </Private>

        <Private entityRef="BackgroundParking4">
          <PrivateAction>
            <TeleportAction>
              <Position>
                <LanePosition roadId="$roadId" laneId="$backgroundLane" offset="$backgroundOffset"
                  s="${$initialS + 2 * $backgroundGap}"></LanePosition>
              </Position>
            </TeleportAction>
          </PrivateAction>
        </Private>

        <Private entityRef="BackgroundParking5">
          <PrivateAction>
            <TeleportAction>
              <Position>
                <LanePosition roadId="$roadId" laneId="$backgroundLane" offset="$backgroundOffset"
                  s="${$initialS - 2 * $backgroundGap}"></LanePosition>
              </Position>
            </TeleportAction>
          </PrivateAction>
        </Private>

        <Private entityRef="BackgroundParking6">
          <PrivateAction>
            <TeleportAction>
              <Position>
                <LanePosition roadId="$roadId" laneId="$backgroundLane" offset="$backgroundOffset"
                  s="${$initialS + 3 * $backgroundGap}"></LanePosition>
              </Position>
            </TeleportAction>
          </PrivateAction>
        </Private>

        <Private entityRef="BackgroundParking7">
          <PrivateAction>
            <TeleportAction>
              <Position>
                <LanePosition roadId="$roadId" laneId="$backgroundLane" offset="$backgroundOffset"
                  s="${$initialS - 3 * $backgroundGap}"></LanePosition>
              </Position>
            </TeleportAction>
          </PrivateAction>
        </Private>

      </Actions>
    </Init>


    <Story name="OvertakeStory">

      <Act name="StartValidAct">
        <StartTrigger>
          <ConditionGroup>
            <Condition name="StartValidCondition" delay="0" conditionEdge="none">
              <ByEntityCondition>
                <TriggeringEntities triggeringEntitiesRule="any">
                  <EntityRef entityRef="Ego" />
                </TriggeringEntities>
                <EntityCondition>
                  <ReachPositionCondition tolerance="3.0">
                    <Position>
                      <LanePosition roadId="61" laneId="-1" s="0" offset="0" />
                    </Position>
                  </ReachPositionCondition>
                </EntityCondition>
              </ByEntityCondition>
            </Condition>
          </ConditionGroup>
        </StartTrigger>
      </Act>

      <Act name="StartSamplingAct">
        <StartTrigger>
          <ConditionGroup>
            <Condition name="StartSamplingCondition" delay="0" conditionEdge="none">
              <ByEntityCondition>
                <TriggeringEntities triggeringEntitiesRule="any">
                  <EntityRef entityRef="Ego" />
                </TriggeringEntities>
                <EntityCondition>
                  <ReachPositionCondition tolerance="3.0">
                    <Position>
                      <WorldPosition x="243.43" y="19.62" z="0.0" />
                    </Position>
                  </ReachPositionCondition>
                </EntityCondition>
              </ByEntityCondition>
            </Condition>
          </ConditionGroup>
        </StartTrigger>
      </Act>

      <Act name="TriggerMovingAct">
        <ManeuverGroup maximumExecutionCount="1" name="RouteManeuverGroup">
          <Actors selectTriggeringEntities="false">
            <EntityRef entityRef="Opposite" />
          </Actors>
          <Maneuver name="MovingAct">
            <Event name="MovingEvent" maximumExecutionCount="1" priority="overwrite">

              <Action name="TeleportAction">
                <PrivateAction>
                  <TeleportAction>
                    <Position>
                      <RelativeLanePosition entityRef="Parking" dLane="2" ds="$initialDelta"
                        offset="$y0" />
                    </Position>
                  </TeleportAction>
                </PrivateAction>
              </Action>

              <Action name="RouteSpeedAction">
                <PrivateAction>
                  <LongitudinalAction>
                    <SpeedAction>
                      <SpeedActionDynamics dynamicsShape="step" value="0.0"
                        dynamicsDimension="time" />
                      <SpeedActionTarget>
                        <AbsoluteTargetSpeed value="${$v0 / 3.6}" />
                      </SpeedActionTarget>
                    </SpeedAction>
                  </LongitudinalAction>
                </PrivateAction>
              </Action>

              <StartTrigger>

                <ConditionGroup>
                  <Condition name="StartMovingCondition" delay="0" conditionEdge="rising">
                    <ByEntityCondition>
                      <TriggeringEntities triggeringEntitiesRule="any">
                        <EntityRef entityRef="Parking" />
                      </TriggeringEntities>
                      <EntityCondition>
                        <RelativeDistanceCondition relativeDistanceType="longitudinal"
                          entityRef="Ego" rule="lessThan" value="$x0"
                          freespace="true" alongRoute="false" />
                      </EntityCondition>
                    </ByEntityCondition>
                  </Condition>
                </ConditionGroup>

              </StartTrigger>

            </Event>
          </Maneuver>
        </ManeuverGroup>
      </Act>

    </Story>

    <StopTrigger>

      <ConditionGroup>
        <Condition name="EgoReachDestinationCondition" delay="0" conditionEdge="rising">
          <ByEntityCondition>
            <TriggeringEntities triggeringEntitiesRule="any">
              <EntityRef entityRef="Ego" />
            </TriggeringEntities>
            <EntityCondition>
              <ReachPositionCondition tolerance="5">
                <Position>
                  <WorldPosition x="525.88" y="213.82" z="0.0" />
                </Position>
              </ReachPositionCondition>
            </EntityCondition>
          </ByEntityCondition>
        </Condition>
      </ConditionGroup>

      <ConditionGroup>
        <Condition name="EgoStuckCondition" delay="0" conditionEdge="rising">
          <ByEntityCondition>
            <TriggeringEntities triggeringEntitiesRule="any">
              <EntityRef entityRef="Ego" />
            </TriggeringEntities>
            <EntityCondition>
              <StandStillCondition duration="10" />
            </EntityCondition>
          </ByEntityCondition>
        </Condition>
      </ConditionGroup>

    </StopTrigger>

  </Storyboard>

</OpenSCENARIO>
