{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Stage2Context",
  "type": "object",
  "required": ["run_id", "stage", "summary", "sections"],
  "properties": {
    "run_id": { "type": "string" },
    "stage": { "type": "string", "const": "stage2_context" },
    "summary": { "type": "string" },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "content"],
        "properties": {
          "title": { "type": "string" },
          "content": { "type": "string" }
        }
      }
    }
  }
}
